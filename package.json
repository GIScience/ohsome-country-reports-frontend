{
  "name": "ohsome-country-reports",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "VITE_BASE_URL=/ vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "i18n:report": "vue-i18n-extract report --vueFiles './src/**/*.?(ts|vue)' --languageFiles './src/locales/*.json'"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/helpers": "^7.4.0",
    "@turf/union": "^7.4.0",
    "hyparquet": "^1.31.5",
    "js-yaml": "^4.1.1",
    "maplibre-gl": "^5.24.0",
    "pbf": "^5.1.2",
    "plotly.js-dist-min": "^3.4.0",
    "pmtiles": "^4.4.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/maplibre-gl": "^1.13.2",
    "@types/node": "^24.12.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.2.5"
  }
}
